func @main(): int32_t
{
	uintptr_t f_cmp_u8 = func @cmp_u8(uint8_t, uint8_t): void;
	uint8_t a_cmp_u8 = 200;
	uint8_t b_cmp_u8 = 100;
	uintptr_t f_cmp_i8 = func @cmp_i8(int8_t, int8_t): void;
	int8_t a_cmp_i8 = -56;
	int8_t b_cmp_i8 = 100;
	uintptr_t f_cmp_u16 = func @cmp_u16(uint16_t, uint16_t): void;
	uint16_t a_cmp_u16 = 36864;
	uint16_t b_cmp_u16 = 16;
	uintptr_t f_cmp_i16 = func @cmp_i16(int16_t, int16_t): void;
	int16_t a_cmp_i16 = -28672;
	int16_t b_cmp_i16 = 16;
	int32_t z = 0;
	l_1 = START(l_6);
	l_2 = CALL/2(l_1, f_cmp_u8, a_cmp_u8, b_cmp_u8);
	l_3 = CALL/2(l_2, f_cmp_i8, a_cmp_i8, b_cmp_i8);
	l_4 = CALL/2(l_3, f_cmp_u16, a_cmp_u16, b_cmp_u16);
	l_5 = CALL/2(l_4, f_cmp_i16, a_cmp_i16, b_cmp_i16);
	l_6 = RETURN(l_5, z);
}
