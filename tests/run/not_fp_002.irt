--TEST--
Boolean NOT of FP values (-O0)
--ARGS--
--run -O0
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func not_d(double): int32_t
{
	l_1 = START(l_2);
	double d_1 = PARAM(l_1, "x", 1);
	bool d_2 = NOT(d_1);
	int32_t d_3 = ZEXT(d_2);
	l_2 = RETURN(l_1, d_3);
}
func not_f(float): int32_t
{
	l_1 = START(l_2);
	float d_1 = PARAM(l_1, "x", 1);
	bool d_2 = NOT(d_1);
	int32_t d_3 = ZEXT(d_2);
	l_2 = RETURN(l_1, d_3);
}
func not_not_d(double): int32_t
{
	l_1 = START(l_2);
	double d_1 = PARAM(l_1, "x", 1);
	bool d_2 = NOT(d_1);
	bool d_3 = NOT(d_2);
	int32_t d_4 = ZEXT(d_3);
	l_2 = RETURN(l_1, d_4);
}
func main(void): int32_t
{
	uintptr_t c_printf = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_fmt = "%d%d%d%d%d %d%d%d%d%d %d%d%d%d%d\n";
	uintptr_t c_not_d = func not_d(double): int32_t;
	uintptr_t c_not_f = func not_f(float): int32_t;
	uintptr_t c_not_not_d = func not_not_d(double): int32_t;
	double c_d0 = 0.0;
	double c_dn0 = -0.0;
	double c_d1 = 1.5;
	double c_dnan = nan;
	double c_dinf = inf;
	float c_f0 = 0.0;
	float c_fn0 = -0.0;
	float c_f1 = 1.5;
	float c_fnan = nan;
	float c_finf = inf;
	int32_t c_ret = 0;
	l_1 = START(l_99);
	int32_t r_1, l_2 = CALL/1(l_1, c_not_d, c_d0);
	int32_t r_2, l_3 = CALL/1(l_2, c_not_d, c_dn0);
	int32_t r_3, l_4 = CALL/1(l_3, c_not_d, c_d1);
	int32_t r_4, l_5 = CALL/1(l_4, c_not_d, c_dnan);
	int32_t r_5, l_6 = CALL/1(l_5, c_not_d, c_dinf);
	int32_t r_6, l_7 = CALL/1(l_6, c_not_f, c_f0);
	int32_t r_7, l_8 = CALL/1(l_7, c_not_f, c_fn0);
	int32_t r_8, l_9 = CALL/1(l_8, c_not_f, c_f1);
	int32_t r_9, l_10 = CALL/1(l_9, c_not_f, c_fnan);
	int32_t r_10, l_11 = CALL/1(l_10, c_not_f, c_finf);
	int32_t r_11, l_12 = CALL/1(l_11, c_not_not_d, c_d0);
	int32_t r_12, l_13 = CALL/1(l_12, c_not_not_d, c_dn0);
	int32_t r_13, l_14 = CALL/1(l_13, c_not_not_d, c_d1);
	int32_t r_14, l_15 = CALL/1(l_14, c_not_not_d, c_dnan);
	int32_t r_15, l_16 = CALL/1(l_15, c_not_not_d, c_dinf);
	int32_t d_p, l_17 = CALL/16(l_16, c_printf, c_fmt, r_1, r_2, r_3, r_4, r_5, r_6, r_7, r_8, r_9, r_10, r_11, r_12, r_13, r_14, r_15);
	l_99 = RETURN(l_17, c_ret);
}
--EXPECT--
11000 11000 00111
