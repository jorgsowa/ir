--TEST--
LIVE GT U64 MISMATCH: minimal run-option reproducer
--TARGET--
aarch64
--ARGS--
-O2 --run
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func small(void): uint64_t
{
	uint64_t c_small = 8;
	l_1 = START(l_ret);
	l_ret = RETURN(l_1, c_small);
}
func main(void): int32_t
{
	uint64_t c_all = 0xffffffffffffffff;
	uintptr_t c_small_fn = func small(void): uint64_t;
	uintptr_t c_printf = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_fmt = "0x%llx\n";
	int32_t c_zero = 0;
	l_1 = START(l_ret);
	uint64_t d_small, l_2 = CALL/0(l_1, c_small_fn);
	bool d_gt = GT(c_all, d_small);
	l_3 = IF(l_2, d_gt);
	l_4 = IF_TRUE(l_3);
	l_5 = END(l_4);
	l_6 = IF_FALSE(l_3);
	l_7 = END(l_6);
	l_8 = MERGE(l_5, l_7);
	uint64_t d_result = PHI(l_8, c_all, d_small);
	int32_t ignored, l_print = CALL/2(l_8, c_printf, c_fmt, d_result);
	l_ret = RETURN(l_print, c_zero);
}
--EXPECT--
0xffffffffffffffff
