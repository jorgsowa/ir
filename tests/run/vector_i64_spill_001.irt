--TEST--
64-bit vector splat and replace with scalar register pressure
--ARGS--
--run
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func test(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t): int64_t
{
	int32_t c_0 = 0;
	int32_t c_1 = 1;
	l_1 = START(l_18);
	int64_t x = PARAM(l_1, "x", 1);
	int64_t y = PARAM(l_1, "y", 2);
	int64_t a = PARAM(l_1, "a", 3);
	int64_t b = PARAM(l_1, "b", 4);
	int64_t c = PARAM(l_1, "c", 5);
	int64_t d = PARAM(l_1, "d", 6);
	int64_t e = PARAM(l_1, "e", 7);
	int64_t f = PARAM(l_1, "f", 8);
	<int64_t*2> v = SPLAT(x);
	<int64_t*2> w = REPLACE(v, c_1, y);
	int64_t lo = EXTRACT(w, c_0);
	int64_t hi = EXTRACT(w, c_1);
	int64_t s1 = ADD(lo, hi);
	int64_t s2 = ADD(a, b);
	int64_t s3 = ADD(c, d);
	int64_t s4 = ADD(e, f);
	int64_t s5 = ADD(s1, s2);
	int64_t s6 = ADD(s3, s4);
	int64_t result = ADD(s5, s6);
	l_18 = RETURN(l_1, result);
}
func main(void): int32_t
{
	int64_t c_x = 0x0123456789abcdef;
	int64_t c_y = 0x1020304050607080;
	int64_t c_1 = 1;
	int64_t c_2 = 2;
	int64_t c_3 = 3;
	int64_t c_4 = 4;
	int64_t c_5 = 5;
	int64_t c_6 = 6;
	uintptr_t c_test = func test(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t): int64_t;
	uintptr_t c_printf = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_format = "%llx\n";
	int32_t c_zero = 0;
	l_1 = START(l_5);
	int64_t r_1, l_2 = CALL/8(l_1, c_test, c_x, c_y, c_1, c_2, c_3, c_4, c_5, c_6);
	int32_t r_2, l_3 = CALL/2(l_2, c_printf, c_format, r_1);
	l_5 = RETURN(l_3, c_zero);
}
--EXPECT--
114375a7da0c3e84
