--TEST--
8-bit and 16-bit shifts by a variable amount computed from the shifted value
--ARGS--
-O1 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @SHL_uint8_t(uint8_t): int32_t;
func @SHL_uint8_t(uint8_t): int32_t
{
	uint8_t c_m = 7;
	l_1 = START(l_2);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t n = AND(x, c_m);
	uint8_t s = SHL(x, n);
	uint8_t m = XOR(s, x);
	int32_t r = ZEXT(m);
	l_2 = RETURN(l_1, r);
}
func @SHR_uint8_t(uint8_t): int32_t;
func @SHR_uint8_t(uint8_t): int32_t
{
	uint8_t c_m = 7;
	l_1 = START(l_2);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t n = AND(x, c_m);
	uint8_t s = SHR(x, n);
	uint8_t m = XOR(s, x);
	int32_t r = ZEXT(m);
	l_2 = RETURN(l_1, r);
}
func @SAR_uint8_t(uint8_t): int32_t;
func @SAR_uint8_t(uint8_t): int32_t
{
	uint8_t c_m = 7;
	l_1 = START(l_2);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t n = AND(x, c_m);
	uint8_t s = SAR(x, n);
	uint8_t m = XOR(s, x);
	int32_t r = ZEXT(m);
	l_2 = RETURN(l_1, r);
}
func @SHL_uint16_t(uint16_t): int32_t;
func @SHL_uint16_t(uint16_t): int32_t
{
	uint16_t c_m = 15;
	l_1 = START(l_2);
	uint16_t x = PARAM(l_1, "x", 1);
	uint16_t n = AND(x, c_m);
	uint16_t s = SHL(x, n);
	uint16_t m = XOR(s, x);
	int32_t r = ZEXT(m);
	l_2 = RETURN(l_1, r);
}
func @SHR_uint16_t(uint16_t): int32_t;
func @SHR_uint16_t(uint16_t): int32_t
{
	uint16_t c_m = 15;
	l_1 = START(l_2);
	uint16_t x = PARAM(l_1, "x", 1);
	uint16_t n = AND(x, c_m);
	uint16_t s = SHR(x, n);
	uint16_t m = XOR(s, x);
	int32_t r = ZEXT(m);
	l_2 = RETURN(l_1, r);
}
func @SAR_uint16_t(uint16_t): int32_t;
func @SAR_uint16_t(uint16_t): int32_t
{
	uint16_t c_m = 15;
	l_1 = START(l_2);
	uint16_t x = PARAM(l_1, "x", 1);
	uint16_t n = AND(x, c_m);
	uint16_t s = SAR(x, n);
	uint16_t m = XOR(s, x);
	int32_t r = ZEXT(m);
	l_2 = RETURN(l_1, r);
}
func @main(): int32_t
{
	uint16_t a5 = 23130;
	uintptr_t f5 = func @SAR_uint16_t(uint16_t): int32_t;
	uint16_t a4 = 23130;
	uintptr_t f4 = func @SHR_uint16_t(uint16_t): int32_t;
	uint16_t a3 = 23130;
	uintptr_t f3 = func @SHL_uint16_t(uint16_t): int32_t;
	uint8_t a2 = 182;
	uintptr_t f2 = func @SAR_uint8_t(uint8_t): int32_t;
	uint8_t a1 = 182;
	uintptr_t f1 = func @SHR_uint8_t(uint8_t): int32_t;
	uint8_t a0 = 182;
	uintptr_t f0 = func @SHL_uint8_t(uint8_t): int32_t;
	uintptr_t fp = func @printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%d %d %d %d %d %d\n";
	int32_t z = 0;
	l_1 = START(l_9);
	int32_t r0, l_2 = CALL/1(l_1, f0, a0);
	int32_t r1, l_3 = CALL/1(l_2, f1, a1);
	int32_t r2, l_4 = CALL/1(l_3, f2, a2);
	int32_t r3, l_5 = CALL/1(l_4, f3, a3);
	int32_t r4, l_6 = CALL/1(l_5, f4, a4);
	int32_t r5, l_7 = CALL/1(l_6, f5, a5);
	l_8 = CALL/7(l_7, fp, fmt, r0, r1, r2, r3, r4, r5);
	l_9 = RETURN(l_8, z);
}
--EXPECT--
54 180 72 12890 23116 23116
