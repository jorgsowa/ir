--TEST--
Signed DIV/MOD of 8-bit and 16-bit values by a power of two
--ARGS--
-O1 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @f0(int16_t): int16_t;
func @f0(int16_t): int16_t
{
	int16_t c = 8;
	l_1 = START(l_2);
	int16_t x = PARAM(l_1, "x", 1);
	int16_t d = DIV(x, c);
	int16_t r = DIV(d, c);
	l_2 = RETURN(l_1, r);
}
