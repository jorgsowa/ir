--TEST--
001: SUB with 64-bit constant requiring movz/movk sequence
--TARGET--
aarch64
--ARGS--
-S
--CODE--
{
	uint64_t c = 0x100000000;
	l_1 = START(l_4);
	uint64_t x = PARAM(l_1, "x", 1);
	uint64_t ret = SUB(x, c);
	l_4 = RETURN(l_1, ret);
}
--EXPECT--
test:
	movz x1, #0x1, lsl #32
	sub x0, x0, x1
	ret
